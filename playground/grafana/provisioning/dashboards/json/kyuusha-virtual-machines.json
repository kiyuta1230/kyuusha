{
  "title": "kyuusha: virtual machines",
  "uid": "kyuusha-virtual-machines",
  "description": "VMに関するメトリクスを1画面に集約: 件数(phase別)、テナント別内訳、実cgroup由来のCPU/メモリ使用量(compute-agentの/metrics/resources、docs/specs/observability-metrics.md参照)。kyuusha: fleetのVMパネルとkyuusha: compute-agentのVMパネルを、VM単体で見たい時のためにここへまとめている。",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(kyuusha_virtualmachines_total, tenant_id)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "vm_id",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(kyuusha_vm_memory_usage_bytes{tenant_id=~\"$tenant\"}, vm_id)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "VM count (by phase)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (phase) (kyuusha_virtualmachines_total{tenant_id=~\"$tenant\"})",
          "legendFormat": "{{phase}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "VM count (by tenant, all phases combined)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (tenant_id) (kyuusha_virtualmachines_total{tenant_id=~\"$tenant\"})",
          "legendFormat": "{{tenant_id}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "VM CPU usage (rate, by vm_id) -- real cgroup usage_usec",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(kyuusha_vm_cpu_usage_seconds_total{tenant_id=~\"$tenant\", vm_id=~\"$vm_id\"}[1m])",
          "legendFormat": "{{hypervisor}} {{tenant_id}} {{vm_id}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "VM memory usage vs limit (by vm_id) -- real cgroup memory.current/memory.max",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "kyuusha_vm_memory_usage_bytes{tenant_id=~\"$tenant\", vm_id=~\"$vm_id\"}",
          "legendFormat": "{{hypervisor}} {{tenant_id}} {{vm_id}} usage"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "kyuusha_vm_memory_limit_bytes{tenant_id=~\"$tenant\", vm_id=~\"$vm_id\"}",
          "legendFormat": "{{hypervisor}} {{tenant_id}} {{vm_id}} limit"
        }
      ]
    },
    {
      "id": 5,
      "title": "VM memory usage / limit ratio (by vm_id)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "kyuusha_vm_memory_usage_bytes{tenant_id=~\"$tenant\", vm_id=~\"$vm_id\"} / on (hypervisor, tenant_id, vm_id) kyuusha_vm_memory_limit_bytes",
          "legendFormat": "{{hypervisor}} {{tenant_id}} {{vm_id}}"
        }
      ]
    }
  ]
}
