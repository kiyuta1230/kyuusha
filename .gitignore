/bin/
*.test
*.out

# `go build ./...` from the repo root writes each main package's binary
# here by its package name (cmd/kyuusha -> ./kyuusha, playground/ocitool ->
# ./ocitool), and `go build ./cmd/<name>` does the same for any one of them,
# unless -o is given -- easy to do by accident, so ignore the
# known binary names instead of relying on remembering -o every time.
/kyuusha
/ocitool
/api-gateway
/block-storage
/block-storage-reconciler
/compute
/compute-agent
/compute-reconciler
/identity
/image
/network
/network-reconciler

# The playground's "playground-nfs" storage connection fixture -- a plain
# host directory standing in for a real NFS export, bind-mounted into every
# compute-agent container (see playground/docker-compose.yml and
# internal/compute-agent/volumeref). scenario.sh writes real Volume backing
# files into it at runtime; nothing here should be committed.
/playground/volume-data/

# containerlab's own lab-state directory (SSH configs, node startup
# configs, etc.), named after each lab's own topo.clab.yml's `name:`.
# run-test.sh/cleanup.sh manage its lifecycle; nothing here should be
# committed.
/playground/vlan-clos/clab-vlan-clos/
/playground/ipv4-unicast-clos/clab-ipv4-unicast-clos/
/playground/evpn-vxlan-clos/clab-evpn-vxlan-clos/
/playground/vrf-lite-clos/clab-vrf-lite-clos/
